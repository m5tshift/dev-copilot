# Copy to .env and adjust. All settings with comments: src/devcopilot/config.py
# DEVCOPILOT_DOTENV=0 in the environment makes the code ignore this file (tool servers, tests).

# LLM (Ollama)
DEVCOPILOT_MODEL=qwen3.5:9b
DEVCOPILOT_OLLAMA_BASE_URL=http://localhost:11434
# Context window: memory grows with it (~10 GB at 8192, ~16 GB at 16384 for qwen3.5:9b)
DEVCOPILOT_NUM_CTX=8192
# true = the model thinks before each step: better tool choice, several times slower
DEVCOPILOT_REASONING=false
# DEVCOPILOT_TEMPERATURE=0.0
# How to get JSON: function_calling (any tool-capable model) | json_schema | json_mode
# DEVCOPILOT_STRUCTURED_METHOD=function_calling

# Model routing by role (src/devcopilot/llm.py): gate, supervisor, specialist,
# synthesizer, validator. The validator must be of ANOTHER family than the generator.
# Default (the product): the gate's LLM fallback on the 4B, the validator on Gemma.
# DEVCOPILOT_ROUTES=gate=qwen3.5:4b,validator=gemma4:e4b
# The validator thinks before its verdict (9 real checks: 2/9 rejected with thinking, 9/9 without)
# DEVCOPILOT_VALIDATOR_REASONING=true
# LLM check of every specialist report on top of the deterministic one: ~90 s per report with thinking
# DEVCOPILOT_VALIDATE_REPORTS=false

# Agent loop and team
DEVCOPILOT_MAX_STEPS=12
# DEVCOPILOT_TEAM_MAX_ROUNDS=4
# DEVCOPILOT_TEAM_MAX_REVISIONS=1
# DEVCOPILOT_SPECIALIST_MAX_STEPS=8
# Skills from skills/*/SKILL.md (load_skill tool); false = off, for A/B evals
# DEVCOPILOT_SKILLS=true

# Typed decisions by a Jev-like decision model, see src/devcopilot/decide.py.
# Default: the gate on winnow:e4b served by ollaya at localhost:11435 (threshold 0.5);
# if the server is down or answers garbage, the gate's LLM decides, the metric
# devcopilot.decider.fallbacks grows and the DecisionModelUnavailable alert fires.
# DEVCOPILOT_JEV_FOR=gate              # "" = no decision model; also: review, stop, judge, online
# DEVCOPILOT_JEV_BASE_URL=http://localhost:11435   # in the sandbox: http://host.docker.internal:11435
# DEVCOPILOT_JEV_MODEL=winnow:e4b
# DEVCOPILOT_JEV_GATE_THRESHOLD=0.5
# DEVCOPILOT_JEV_YES_THRESHOLD=0.7
# DEVCOPILOT_JEV_STOP_THRESHOLD=0.9
# Per attempt, 3 attempts: a hung server delays the LLM fallback by up to 3x this
# DEVCOPILOT_JEV_TIMEOUT_S=60
# DEVCOPILOT_JEV_MAX_LEN=              # laya only

# Memory (src/devcopilot/memory.py): SQLite checkpoints, episodes, temporal facts
# DEVCOPILOT_MEMORY=false
# DEVCOPILOT_MEMORY_DIR=.memory
# DEVCOPILOT_EMBED_MODEL=qwen3-embedding:0.6b
# DEVCOPILOT_EPISODE_RECALL_K=3
# DEVCOPILOT_EPISODE_MIN_SIMILARITY=0.6   # from eval memory: precision 67%, recall 80%
# DEVCOPILOT_EPISODE_DEDUP_SIMILARITY=0.95
# DEVCOPILOT_EPISODE_HALF_LIFE_DAYS=14
# DEVCOPILOT_EPISODE_TTL_DAYS=90
# DEVCOPILOT_EPISODE_ANSWER_CHARS=800
# Compaction: the most memory any reading agent gets per run, and per past episode
# DEVCOPILOT_MEMORY_CONTEXT_CHARS=1500
# DEVCOPILOT_EPISODE_DIGEST_CHARS=300
# Team follow-up turns: earlier turns as a digest of at most this many characters
# DEVCOPILOT_HISTORY_CHARS=1200

# Observability (phase 3): start observability/docker-compose.yml first
# DEVCOPILOT_OTEL_ENDPOINT=http://localhost:4318
# Chaos testing: share of MCP tool calls that fail on purpose
# DEVCOPILOT_CHAOS_TOOL_ERROR_RATE=0.5

# Simulated world (devcopilot seed)
# DEVCOPILOT_WORKSPACE_DIR=workspace

# Transient failures: total attempts per node, initial exponential backoff, checkpoint resumes.
DEVCOPILOT_NODE_RETRY_ATTEMPTS=3
DEVCOPILOT_NODE_RETRY_BACKOFF_S=1.0
DEVCOPILOT_RUN_RESUME_ATTEMPTS=1
DEVCOPILOT_CHAOS_LLM_ERROR_RATE=0.0

# Timeout for Ollama metadata and unload requests (seconds).
DEVCOPILOT_OLLAMA_CONTROL_TIMEOUT_S=10
